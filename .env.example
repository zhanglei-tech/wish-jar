# 复制为 .env 后修改。不要提交真实的 .env。
# 用于签名登录 Cookie，请换成随机长字符串。
SECRET_KEY=please-change-this-to-a-long-random-string

# 宿主机端口。群晖上可按需改成 8899 等。
APP_PORT=8000

# 通过 HTTPS 反向代理访问时设为 true；内网 HTTP 访问保持 false。
COOKIE_SECURE=false

# 家庭时区，用于“今天 / 本周”和连续打卡。
TZ=Asia/Shanghai

# 使用 docker-compose.nas.yml 从 GHCR 拉取镜像时填写；本地构建不需要。
# 发布工作流会生成 ghcr.io/zhanglei-tech/wish-jar:<版本>
# WISH_JAR_IMAGE=ghcr.io/zhanglei-tech/wish-jar:1.0.0
